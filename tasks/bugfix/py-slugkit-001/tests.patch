+import unittest
+
+from slugkit import slugify
+
+
+class TestSeparators(unittest.TestCase):
+    def test_punctuation_and_repeated_spaces(self):
+        self.assertEqual(slugify("Hello,  World!"), "hello-world")
+
+    def test_no_separator_at_the_ends(self):
+        self.assertEqual(slugify("  --Draft: v2--  "), "draft-v2")
+
+
+if __name__ == "__main__":
+    unittest.main()
